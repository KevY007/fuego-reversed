# ---- Build output ----
/bin/
/obj/
/FuegoReversed/          # MSBuild intermediate dir (Release/*.obj)
[Dd]ebug/
[Rr]elease/
x64/
Win32/

# ---- Visual Studio ----
.vs/
*.user
*.suo
*.VC.db
*.VC.opendb
*.aps
*.ncb

# ---- Compiler / linker intermediates ----
*.obj
*.pdb
*.ilk
*.idb
*.ipdb
*.iobj
*.tlog
*.lastbuildstate
*.exp
*.res

# ---- Build output binaries ----
*.asi

# ---- Vendored imgui demo apps + prebuilt libs (the build only uses imgui core + the
#      dx9/win32 backends, not the examples) ----
vendor/imgui/examples/

# ---- OS cruft ----
Thumbs.db
Desktop.ini
.DS_Store

# ---- Dependencies (scripts/bootstrap.ps1) ----
# project-local Conan cache + everything generated from the gta-reversed submodule
/external/.conan2/
/external/generated/

# ---- i18n runtime files (never commit -- fuego_i18n.cfg is the BYOK config
#      and can contain a plaintext api_key; fuego_i18n_tm.txt is the
#      on-disk translation-memory cache written at runtime) ----
/fuego_i18n.cfg
/fuego_i18n_tm.txt

# ---- i18n host test artifacts (written into the repo by tests/run_tests.cmd,
#      not build output) ----
tests/i18n_tests.exe
tests/*.obj
test_cfg.cfg
test_tm.txt
engine_test_tm.txt
