<?xml version="1.0" encoding="utf-8"?>
<!--
  gta_link.props : linker inputs for the gta-reversed static lib + its conan deps.
  Imported by FuegoReversed.vcxproj; referenced from the Link section so the whole
  game layer links in one shot. The C:\ch\... paths are the conan cache (short
  CONAN_HOME) for this machine's install.
-->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <ConanCache>C:\ch\p\b</ConanCache>
    <GtaLinkDirs>D:\hax0r\gta-reversed\bin\Release;$(ConanCache)\sdl20a00248b7e4e\p\lib;$(ConanCache)\ogg99dfcb1df3488\p\lib;$(ConanCache)\vorbi4429a57040e7d\p\lib;$(ConanCache)\libjpac656b9c8e9b2\p\lib;$(ConanCache)\spdlo6b74db63ad47f\p\lib;$(ConanCache)\tracy8fb49631a3c92\p\lib;$(ConanCache)\libus6ffdf51d2ec73\p\lib</GtaLinkDirs>
    <GtaLinkDeps>gta_reversed.lib;SDL3-static.lib;ogg.lib;vorbis.lib;vorbisenc.lib;vorbisfile.lib;jpeg-static.lib;turbojpeg-static.lib;spdlog.lib;TracyClient.lib;libusb-1.0.lib;advapi32.lib;dbghelp.lib;gdi32.lib;imm32.lib;kernel32.lib;ole32.lib;oleaut32.lib;opengl32.lib;setupapi.lib;shell32.lib;user32.lib;uuid.lib;version.lib;winmm.lib;ws2_32.lib;ddraw.lib;dsound.lib;dxguid.lib</GtaLinkDeps>
  </PropertyGroup>
</Project>
