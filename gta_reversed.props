<?xml version="1.0" encoding="utf-8"?>
<!--
  gta_reversed.props : build settings for the gta-reversed game layer.

  Scoped (in FuegoReversed.vcxproj) to the src\gta\ bridge TUs only, so the rest
  of the project stays lean C++20. gta-reversed needs C++23 (plus /Zc:preprocessor),
  its RenderWare-ordered include roots, the vendored header deps (json/spdlog/
  Tracy-stub under vendor\gta-deps), and its feature defines. EXTRA_DEBUG_FEATURES
  is deliberately NOT defined so gta-reversed's imgui toolsmenu is skipped (it
  wants an older imgui than we ship).
-->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <GtaRoot>$(MSBuildThisFileDirectory)..\gta-reversed\source</GtaRoot>
    <GtaDeps>$(MSBuildThisFileDirectory)vendor\gta-deps</GtaDeps>
    <GtaImgui>$(MSBuildThisFileDirectory)vendor\imgui</GtaImgui>
    <GtaReversedDefines>NOMINMAX;FIX_BUGS;NOTSA_WINDOWED_MODE;SA_SKINNED_PEDS;USE_D3D9;USE_GTASA_ALLOCATOR;SPDLOG_USE_STD_FORMAT</GtaReversedDefines>
    <GtaReversedIncludes>$(GtaDeps);$(GtaImgui);$(GtaRoot);$(GtaRoot)\game_sa;$(GtaRoot)\game_sa\Animation;$(GtaRoot)\game_sa\Attractors;$(GtaRoot)\game_sa\Audio;$(GtaRoot)\game_sa\Audio\Config;$(GtaRoot)\game_sa\Audio\Data;$(GtaRoot)\game_sa\Audio\Entities;$(GtaRoot)\game_sa\Audio\Enums;$(GtaRoot)\game_sa\Audio\Hardware;$(GtaRoot)\game_sa\Audio\Loaders;$(GtaRoot)\game_sa\Audio\Managers;$(GtaRoot)\game_sa\Audio\OpenAL;$(GtaRoot)\game_sa\Collision;$(GtaRoot)\game_sa\Conversations;$(GtaRoot)\game_sa\Core;$(GtaRoot)\game_sa\Data;$(GtaRoot)\game_sa\DecisionMakers;$(GtaRoot)\game_sa\Entity;$(GtaRoot)\game_sa\Entity\Dummy;$(GtaRoot)\game_sa\Entity\Object;$(GtaRoot)\game_sa\Entity\Ped;$(GtaRoot)\game_sa\Entity\Vehicle;$(GtaRoot)\game_sa\Enums;$(GtaRoot)\game_sa\Events;$(GtaRoot)\game_sa\Frontend;$(GtaRoot)\game_sa\Fx;$(GtaRoot)\game_sa\Fx\Blueprints;$(GtaRoot)\game_sa\Fx\Blueprints\Interp;$(GtaRoot)\game_sa\Handling;$(GtaRoot)\game_sa\Interior;$(GtaRoot)\game_sa\Memory;$(GtaRoot)\game_sa\Models;$(GtaRoot)\game_sa\Pipelines;$(GtaRoot)\game_sa\Pipelines\CustomBuilding;$(GtaRoot)\game_sa\Pipelines\CustomCarEnvMap;$(GtaRoot)\game_sa\Plant;$(GtaRoot)\game_sa\Plugins;$(GtaRoot)\game_sa\Plugins\BreakablePlugin;$(GtaRoot)\game_sa\Plugins\CollisionPlugin;$(GtaRoot)\game_sa\Plugins\JPegCompressPlugin;$(GtaRoot)\game_sa\Plugins\NodeNamePlugin;$(GtaRoot)\game_sa\Plugins\PipelinePlugin;$(GtaRoot)\game_sa\Plugins\RpAnimBlendPlugin;$(GtaRoot)\game_sa\Plugins\TwoDEffectPlugin;$(GtaRoot)\game_sa\Pools;$(GtaRoot)\game_sa\RenderWare;$(GtaRoot)\game_sa\RenderWare\rw;$(GtaRoot)\game_sa\Scripts;$(GtaRoot)\game_sa\Scripts\CommandParser;$(GtaRoot)\game_sa\Scripts\Commands;$(GtaRoot)\game_sa\Scripts\Commands\CLEO;$(GtaRoot)\game_sa\Tasks;$(GtaRoot)\game_sa\Tasks\Allocators;$(GtaRoot)\game_sa\Tasks\Allocators\PedGroup;$(GtaRoot)\game_sa\Tasks\TaskTypes;$(GtaRoot)\game_sa\Tasks\TaskTypes\Interior;$(GtaRoot)\game_sa\Tasks\TaskTypes\SeekEntity;$(GtaRoot)\game_sa\Tasks\TaskTypes\SeekEntity\PosCalculators;$(GtaRoot)\game_sa\Text;$(GtaRoot)\app;$(GtaRoot)\app\platform;$(GtaRoot)\app\platform\win;$(GtaRoot)\app\platform\win\VideoPlayer;$(GtaRoot)\app\securom;$(GtaRoot)\oswrapper;$(GtaRoot)\extensions;$(GtaRoot)\extensions\Configs;$(GtaRoot)\extensions\Shapes</GtaReversedIncludes>
  </PropertyGroup>
</Project>
