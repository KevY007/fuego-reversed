    <ClCompile Include="src\gta\gtastubs.cpp" />
    <ClCompile Include="src\gta\gtahost.cpp">
      <LanguageStandard>$(GtaLanguageStandard)</LanguageStandard>
      <AdditionalOptions>/Zc:preprocessor $(GtaCompileOptions) %(AdditionalOptions)</AdditionalOptions>
