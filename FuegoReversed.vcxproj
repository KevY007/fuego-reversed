  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Release|Win32'">
    <ClCompile>
      <Optimization>MaxSpeed</Optimization>
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <IntrinsicFunctions>true</IntrinsicFunctions>
      <!-- src: lets the i18n subsystem's own headers resolve their sibling includes
           as "i18n/xxx.h" (as tests\run_tests.cmd's standalone `cl /I src` build already does). -->
      <AdditionalIncludeDirectories>$(ProjectDir)src;$(ImguiInclude);$(ImguiBindings);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>WIN32;NDEBUG;_WINDOWS;_USRDLL;_CRT_SECURE_NO_WARNINGS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <RuntimeLibrary>MultiThreaded</RuntimeLibrary>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <WarningLevel>Level3</WarningLevel>
      <SDLCheck>false</SDLCheck>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
    </ClCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <!-- bin\FuegoReversed.map: which object every symbol came from (crash triage,
           and auditing what the gta-reversed archive contributes to the link). -->
      <GenerateMapFile>true</GenerateMapFile>
      <AdditionalDependencies>d3d9.lib;winhttp.lib;$(GtaLinkDeps);%(AdditionalDependencies)</AdditionalDependencies>
      <!-- FORCE:MULTIPLE folds the identical PoolOf<>/Compress* defs that gtahost.obj
           and the lib's PCH both emit (non-inline functions in upstream headers). -->
      <AdditionalOptions>/FORCE:MULTIPLE /IGNORE:4006,4088 %(AdditionalOptions)</AdditionalOptions>
      <IgnoreSpecificDefaultLibraries>%(IgnoreSpecificDefaultLibraries)</IgnoreSpecificDefaultLibraries>
      <EnableCOMDATFolding>true</EnableCOMDATFolding>
      <OptimizeReferences>true</OptimizeReferences>
      <TargetMachine>MachineX86</TargetMachine>
      <RandomizedBaseAddress>false</RandomizedBaseAddress>
    </Link>
  </ItemDefinitionGroup>
